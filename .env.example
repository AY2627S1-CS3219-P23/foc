# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────
# AI-assisted (CS3219 AI Usage Policy disclosure):
# Tool: Claude Code (Fable 5), 2026-09-18; Claude Code (Opus 5) for the
# 2026-09-20 agent MCP tooling variables.
# Scope: Notification Service section added while scaffolding for
# issue #61; RabbitMQ section added for issue #62 (2026-09-19);
# JWT_SECRET comment + WebSocket allowed-origins added for issue #67
# (2026-09-19); retry TTL / max-attempts added for issue #65
# (2026-09-20, values team-decided 2026-09-19); retention window and
# purge-cron vars added for issue #68 (2026-09-20, team decision D9 /
# author decision on the second cron env var);
# NOTIFICATION_DB_HOST_PORT added (2026-09-20) for the agent MCP
# tooling setup. Web frontend section added for issue #108
# (2026-09-21).
# Reviewed by: Leong Wei Zhi (via pull request).
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
# Shared HS256 signing secret — must be at least 32 bytes; the
# notification service consumes it to verify tokens at the STOMP
# CONNECT (issue #67), the user service will issue tokens with it.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Notification Service -----------------------------------
# Host port the service is published on (container listens on 8080)
NOTIFICATION_SERVICE_PORT=8085
# Comma-separated Origin patterns allowed at the WebSocket handshake
# (the browser connects cross-origin; no API gateway exists)
NOTIFICATION_WS_ALLOWED_ORIGINS=http://localhost:*
# Database host/port as seen by the service. compose.yaml overrides
# these to the notification-db container; the values here only apply
# when running the app directly (e.g. ./mvnw spring-boot:run).
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
# PostgreSQL credentials for the service-owned notification DB
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=
# Host port the notification DB container is published on, for local
# tooling (psql, DB GUIs, the postgres MCP server in .mcp.json). The
# mapping in compose.yaml binds it to 127.0.0.1, so the database is
# reachable from your own machine only, never from the LAN.
# Defaults to 5433 so it does not collide with a PostgreSQL you may
# already be running on 5432. Database-per-service: each service that
# gains its own DB publishes it on its own free host port and adds a
# <SERVICE>_DB_HOST_PORT variable here — see the port table in the
# "MCP Servers" section of AGENTS.md before picking one. If your password contains characters that
# are special in a URL (@ : / ? # etc.), percent-encode them in the MCP
# connection string, or pick a password without them.
NOTIFICATION_DB_HOST_PORT=5433
# Event retry policy (D6: backoff between attempts / total attempts
# before an event dead-letters). NOTE: the TTL is baked into the retry
# queue's arguments when it is declared — changing it against a broker
# that already holds the queue fails (PRECONDITION_FAILED) until the
# queue is deleted in the management UI or the rabbitmq-data volume is
# reset. Max attempts only needs a service restart.
NOTIFICATION_RETRY_TTL_MS=10000
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
# Retention window for stored notifications (D9): the purge scheduler
# hard-deletes notification rows once they have been stored longer
# than this many days (cutoff is the row's created_at, not the
# underlying event's occurred_at).
NOTIF_RETENTION_DAYS=30
# Cron schedule (Spring's 6-field format: sec min hour day month
# weekday) controlling how often the purge sweep runs.
NOTIF_PURGE_CRON=0 0 3 * * *

# ---- Web frontend -------------------------------------------
# Host port the web container (nginx serving the SPA build) is
# published on. Also the Vite dev server port, so dev and container
# share one origin — run one or the other, not both.
WEB_PORT=5173
# Per-service API base URLs baked into the SPA bundle (no API gateway;
# the browser calls each service directly). These are browser-visible
# URLs on host-published ports — never compose-internal hostnames.
# Vite inlines them at image build time: after changing one, rebuild
# with `docker compose build web`. Leave empty until the owning
# service claims a host port (see the AGENTS.md port table), and keep
# each value in sync with that service's port variable (e.g. the
# notification URL tracks NOTIFICATION_SERVICE_PORT, default 8085).
VITE_USER_SERVICE_URL=
VITE_SUPPLIER_SERVICE_URL=
VITE_ORDER_SERVICE_URL=
VITE_CREDIT_SERVICE_URL=
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8085

# ---- Agent tooling (optional) --------------------------------
# The `postgres` MCP server in the root .mcp.json needs NO variable
# here: credentials live in a connection profile in your OS keyring
# (`npx -y @microsoft/postgres-mcp connection add ...`). See the
# "MCP Servers" section of AGENTS.md. Only on a headless machine with
# no keyring would you set POSTGRES_MCP_CONNECTION_STRING instead.

# ---- RabbitMQ (shared message broker) ------------------------
# Host ports the broker is published on (AMQP / management UI)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Broker host as seen by consuming services. compose.yaml overrides
# this to the rabbitmq container; the value here only applies when
# running an app directly (e.g. ./mvnw spring-boot:run).
RABBITMQ_HOST=localhost
# Broker credentials (also used as the RabbitMQ default user).
# NOTE: the image applies these only when initializing an EMPTY
# rabbitmq-data volume. To rotate the password later, run
#   docker compose exec rabbitmq rabbitmqctl change_password <user> <new>
# and then update the value here — or remove the rabbitmq-data volume
# (which discards any queued messages).
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=

# ... Add more variables as needed
