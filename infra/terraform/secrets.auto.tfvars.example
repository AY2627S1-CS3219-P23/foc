# Copy to secrets.auto.tfvars (git-ignored) and fill in. Never commit the copy.
# DB/RabbitMQ passwords, JWT_SECRET, OWNER_SETUP_TOKEN and CHAT_INTERNAL_TOKEN
# are generated by Terraform (secrets.tf); only these come from the team.

mail_username = "you@example.com"      # Gmail account for OTP emails
mail_password = ""                     # Gmail app password
mail_from     = "you@example.com"

ghcr_username = ""                     # GitHub user owning the token below
ghcr_token    = ""                     # classic token, read:packages only
