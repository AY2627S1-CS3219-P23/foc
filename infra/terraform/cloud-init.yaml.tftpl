#cloud-config
# AI-assisted (CS3219 AI Usage Policy disclosure):
# Tool: Claude Code (Opus 5.5), 2026-11-05, issue #48 (N5 cloud deployment).
# Scope: first-boot setup of the k3s host per the team's decisions (Leong
# Wei Zhi, 2026-11-05, options Q&A): pinned k3s, Traefik timeouts that keep
# the STOMP WebSockets open, and a checkout of the (public) repo that
# deploy.sh runs from. Runs once; later changes go through the deploy
# workflow.
# Author review: Leong Wei Zhi, pending pull request review.
# 2026-11-08, Claude Code (Fable 5.1), issue #48 (DP7): the External
# Secrets Operator chart is gone; first boot runs infra/k8s/secrets.sh,
# which copies the Secrets Manager values into k3s Secrets from the host.
# Author review: Leong Wei Zhi, pending pull request review.

write_files:
  # Traefik's 60 s read timeout would cut the long-lived STOMP sockets
  # the gateway holds open for 3600 s (docs/gateway.md)
  - path: /var/lib/rancher/k3s/server/manifests/traefik-config.yaml
    content: |
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: traefik
        namespace: kube-system
      spec:
        valuesContent: |-
          additionalArguments:
            - "--entryPoints.web.transport.respondingTimeouts.readTimeout=0s"
            - "--entryPoints.web.transport.respondingTimeouts.idleTimeout=3600s"

runcmd:
  - dnf install -y git jq
  - >-
    for i in 1 2 3 4 5; do
    curl -sfL https://get.k3s.io -o /tmp/k3s-install.sh && break; sleep 10;
    done
  - INSTALL_K3S_VERSION='${k3s_version}' sh /tmp/k3s-install.sh --write-kubeconfig-mode 0600
  - git clone '${repo_url}' /opt/foc
  # the API server answers some seconds after the install returns
  - >-
    for i in $(seq 1 60); do
    k3s kubectl get --raw=/readyz >/dev/null 2>&1 && break; sleep 5;
    done
  # namespace + the two Secrets, so the first deploy finds them (DP7);
  # deploy.sh runs the same script on every deploy
  - bash /opt/foc/infra/k8s/secrets.sh
