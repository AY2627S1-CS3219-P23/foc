    %% External Containers
    SPA["<b>Web App</b><br/>[Container: TypeScript and React]<br/>Shows user balances (User F8.1), filterable transaction<br/>history (Credit F4) and upcoming expiries; admin pool views."]:::container
    GW["<b>API Gateway</b><br/>[Container: nginx]<br/>Routes /api/credit/** to the Credit Service."]:::container
    OS["<b>Order Service</b><br/>[Container: Java and Spring Boot]<br/>Owns the request's status, which is the saga state.<br/>Publishes request events; reacts to credit replies."]:::container
    US["<b>User Service</b><br/>[Container: Java and Spring Boot]<br/>Publishes user.created / user.purged from its outbox."]:::container
    NS["<b>Notification Service</b><br/>[Container: Java and Spring Boot]<br/>Tells each party about credit changes."]:::container
    BRK["<b>Message Broker</b><br/>[Container: RabbitMQ]<br/>request-events, user-events and credit-events exchanges, plus each<br/>consumer's own work, retry and dead-letter queues."]:::container

    %% Credit Service Container Boundary
    subgraph CSA ["<b>Credit Service</b><br/>[Container: Java and Spring Boot]"]
        direction TB

        subgraph Entry ["Entry points"]
            CAC["<b>Credit Controller</b><br/>[Component: Spring MVC RestController]<br/>/credits/me: available/reserved balances (F4.1),<br/>date/amount filtered history (F4.1.2, F4.1.3), upcoming expiries."]:::component
            ADM["<b>Admin Credit Controller</b><br/>[Component: Spring MVC RestController]<br/>/credits/admin (admin JWT): common pool summary,<br/>redistribution runs, long-held reservations."]:::component
            CVH["<b>Error Handler</b><br/>[Component: Spring @RestControllerAdvice]<br/>Maps invalid read-API query parameters<br/>to HTTP error responses."]:::component
            REL["<b>Request Events Listener</b><br/>[Component: Spring AMQP RabbitListener]<br/>Acknowledges after commit; retries, then dead-letters."]:::component
            UEL["<b>User Events Listener</b><br/>[Component: Spring AMQP RabbitListener]<br/>Acknowledges after commit; retries, then dead-letters."]:::component
        end

        subgraph Services
            REH["<b>Request Event Handler</b><br/>[Component: Spring @Service]<br/>submitted: reserve (F2.1). completed: transfer (F3.1).<br/>cancelled / expired: release (F2.1.1). dispute-resolved: split settlement.<br/>Enqueues the matching reply in the same transaction."]:::component
            UEH["<b>User Event Handler</b><br/>[Component: Spring @Service]<br/>user.created: open account with sign-up credits.<br/>user.purged: close account."]:::component
            OPS["<b>Credit Operations Service</b><br/>[Component: Spring @Service]<br/>Idempotent core logic: get-or-create account (F1.1), integer amounts (F1.2),<br/>balance check (F2.1.2), one held-credits record per request (NFR2.2.1),<br/>reservation slices per lot; appends history rows (F4.1.1).<br/>One @Transactional unit per operation, reply included (F5.1, NFR2.1)."]:::component
            QRY["<b>Query Services</b><br/>[Component: Spring @Service]<br/>Credit, Pool and Reservation query services:<br/>read-only, paginated/filtered (JPA Specifications)."]:::component
            SCH["<b>Expiry & Redistribution Scheduler</b><br/>[Component: Spring @Scheduled]<br/>Daily, and once at startup."]:::component
            EXP["<b>Lot Expiry Service</b><br/>[Component: Spring @Service]<br/>Moves expired lots to the common pool (F6.1)."]:::component
            RED["<b>Redistribution Service</b><br/>[Component: Spring @Service]<br/>Monthly: shares pool equally (F6.1.1), rest random (F6.1.2)."]:::component
            OBX["<b>Outbox Publisher</b><br/>[Component: Spring @Scheduled]<br/>Publishes unsent replies and marks each one sent<br/>once the broker confirms it."]:::component
            PRG["<b>Outbox Retention Scheduler</b><br/>[Component: Spring @Scheduled]<br/>Purges sent outbox rows past retention."]:::component
        end

        subgraph Persistence
            REPO["<b>Credit Data Repositories</b><br/>[Component: Spring Data JPA]<br/>Database reads/writes, row locks taken in a fixed order,<br/>and JPA Specifications for history filters."]:::component
        end
    end

    %% Database Container
    DB[("<b>Credit Database</b><br/>[Container: PostgreSQL, Flyway migrations]<br/>CreditAccount, Reserved, ReservationSlice, CreditLot, CommonPool, History,<br/>RedistributionRun, Outbox. Unique keys prevent duplicates (NFR2.2);<br/>CHECK constraints keep balances at or above zero.")]:::database

