flowchart TB
    USERS(["Users: requester / courier / admin<br/>(NUS students and platform admins)"])
    WEB["<b>Web App</b> (web/)<br/>TypeScript + React single-page app;<br/>responsive desktop + mobile UI (UI NFR1);<br/>renders in-app notifications and requester–courier chat"]

    USERS -->|"uses (browser, HTTPS)"| WEB

    USER_SVC["<b>User Service</b><br/>Java + Spring Boot — accounts, auth (JWT, OTP),<br/>roles, profiles;<br/>scheduler: purge deleted accounts after 30 days (User F3.1.3)"]
    SUP_SVC["<b>Supplier Service</b><br/>Java + Spring Boot — vendor/landmark<br/>CRUD, browsing, search and filter"]
    ORDER_SVC["<b>Order Service</b><br/>Java + Spring Boot — request lifecycle: create, accept,<br/>pickup/dropoff, complete, cancel; requester–courier chat;<br/>schedulers: expire unaccepted requests + refund (Order F6.1),<br/>auto-complete unconfirmed orders after 1 h (Order F7.2)"]
    CREDIT_SVC["<b>Credit Service</b><br/>Java + Spring Boot — balances (available + reserved),<br/>reservation, atomic transfer, transaction history;<br/>scheduler: monthly credit redistribution (Credit F7)"]
    NOTIF_SVC["<b>Notification Service</b><br/>Java + Spring Boot — consumes order events,<br/>notifies each party; idempotent, with retries"]
    BROKER[/"<b>Message Broker</b><br/>technology TBD — team decision pending"/]
    EMAIL[["<b>External Email Provider</b><br/>technology TBD — delivers OTP emails<br/>to users' u.nus.edu inboxes"]]

    WEB -->|"REST/JSON: sign-up, login/logout, OTP flows, account<br/>update/delete/recover, roles, admin user management,<br/>profiles (User F1–F8)"| USER_SVC
    WEB -->|"REST/JSON: browse, search, filter suppliers;<br/>admin vendor CRUD (Supplier F1–F2)"| SUP_SVC
    WEB -->|"REST/JSON: create / list / accept / pickup–dropoff /<br/>cancel / complete requests (Order F1–F7, F9, F10)"| ORDER_SVC
    WEB <-->|"real-time chat: text + photo media between requester<br/>and courier (Order F8.1) — transport TBD"| ORDER_SVC
    WEB -->|"REST/JSON: available + reserved balances, filtered<br/>transaction history (Credit F4);<br/>admin credit adjustment (Credit F6)"| CREDIT_SVC
    WEB -->|"REST/JSON: list recent notifications,<br/>mark read/unread (Notif F3)"| NOTIF_SVC
    NOTIF_SVC ==>|"async: order-status updates to each party within 5 s —<br/>client transport TBD (Notif F1.2, Order NFR1.1–1.2)"| WEB

    USER_SVC ==>|"send OTP emails: sign-up verification,<br/>email-change confirmation, password reset<br/>(User F1.1.3, F2.1.1, F2.1.3, F4.2)"| EMAIL
    USER_SVC -->|"REST/JSON: allocate 5 starting credits,<br/>reserved balance 0, on sign-up<br/>(Credit F1.1)"| CREDIT_SVC
    ORDER_SVC -->|"REST/JSON: validate pickup location is a<br/>known supplier/landmark (Order F1.1.1)"| SUP_SVC
    ORDER_SVC -->|"REST/JSON: reserve on create (Credit F2.1), release on<br/>cancel/expiry (Credit F2.1.1), atomic transfer on completion<br/>(Credit F3.1, F5.1); duplicate transfer requests for the same<br/>order processed once (Credit NFR3.2.1; Order F13)"| CREDIT_SVC
    ORDER_SVC ==>|"publish event on every order-status change: created,<br/>accepted, collected, completed, cancelled, expired (Order F11.1);<br/>no state queries, delivery failure never affects the producing<br/>operation (Notif F1.1, F1.4) — M6 async workflow"| BROKER
    BROKER ==>|"deliver events: at-least-once, persisted across restarts<br/>(Notif NFR1.1–1.2); consumer deduplicates, retries, records<br/>exhausted retries, discards stale out-of-order events<br/>(Notif F2.1–F2.4)"| NOTIF_SVC

    USER_DB[("User DB<br/>engine TBD")]
    SUP_DB[("Supplier DB<br/>engine TBD")]
    ORDER_DB[("Order DB<br/>engine TBD")]
    CREDIT_DB[("Credit DB<br/>engine TBD")]
    NOTIF_DB[("Notification DB<br/>engine TBD")]

    USER_SVC ---|"Spring Data JPA"| USER_DB
    SUP_SVC ---|"Spring Data JPA"| SUP_DB
    ORDER_SVC ---|"Spring Data JPA"| ORDER_DB
    CREDIT_SVC ---|"Spring Data JPA"| CREDIT_DB
    NOTIF_SVC ---|"Spring Data JPA"| NOTIF_DB
