%% Legend, decisions and traceability: see docs/notification-service.md
flowchart TB
    ORDER_SVC["<b>Order Service</b> (order-service/)<br/>publishes a typed event on every<br/>request state transition"]
    WEB["<b>Web App</b> (web/)<br/>in-app notification list + toasts;<br/>hydrates courier names at read time (D32)"]
    USER_SVC["<b>User Service</b> (user-service/)<br/>public profile: username"]

    subgraph RABBIT ["RabbitMQ (shared broker — queues below are dedicated to the Notification Service)"]
        EXCH{{"<b>request-events</b><br/>topic exchange, durable"}}
        WORKQ[["<b>work queue</b><br/>durable, bound with request.#"]]
        RETRYQ[["<b>retry queue</b><br/>durable, TTL backoff"]]
        DLQ[["<b>dead-letter queue</b><br/>durable, kept for replay"]]
    end

    subgraph NOTIF ["Notification Service (notification-service/) — Java + Spring Boot"]
        LISTENER["<b>AMQP listener</b><br/>dispatch on body eventType;<br/>manual ack after DB commit"]
        PROCESSOR["<b>Idempotent event processor</b><br/>dedupe by event ID;<br/>one notification per party;<br/>payloads keep party IDs (D32)"]
        API["<b>Notification REST API</b><br/>list + unread count + mark<br/>read/unread (JWT, /notifications/me)"]
        PUSH["<b>STOMP push gateway</b><br/>per-user destinations"]
        PURGE["<b>Retention purge scheduler</b>"]
    end

    NOTIF_DB[("<b>Notification DB</b><br/>PostgreSQL — notifications<br/>+ processed event IDs")]

    ORDER_SVC ==>|"publish request events<br/>(fire-and-forget)"| EXCH
    EXCH ==>|"route: request.#"| WORKQ
    WORKQ ==>|"deliver at-least-once"| LISTENER
    LISTENER ==>|"republish on failure<br/>while attempts remain"| RETRYQ
    RETRYQ ==>|"re-route after TTL"| WORKQ
    WORKQ ==>|"after max attempts, or<br/>unconvertible on first rejection"| DLQ

    LISTENER -->|"typed event"| PROCESSOR
    PROCESSOR ---|"insert notification + event ID<br/>in one transaction"| NOTIF_DB
    PROCESSOR -->|"stored notification"| PUSH
    PUSH ==>|"STOMP push to each<br/>party's /user destination"| WEB
    WEB -->|"REST: list, mark read/unread"| API
    WEB -.->|"GET /users/{id} via gateway,<br/>caller's JWT + SPA cache (D32)"| USER_SVC
    API ---|"read/update rows"| NOTIF_DB
    PURGE ---|"delete rows older<br/>than retention window"| NOTIF_DB

